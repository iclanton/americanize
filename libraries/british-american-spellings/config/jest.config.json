{
  "extends": "@americanize/local-build-rig/profiles/node/config/jest.config.json",

  // The CommonJS build now emits to lib-commonjs/ instead of lib/, so point Jest (which runs
  // the compiled output) at the new folder. These arrays replace the inherited ones.
  "roots": ["<rootDir>/lib-commonjs"],
  "testMatch": ["<rootDir>/lib-commonjs/**/*.test.{cjs,js}"],
  "collectCoverageFrom": [
    "lib-commonjs/**/*.{cjs,js}",
    "!lib-commonjs/**/*.d.ts",
    "!lib-commonjs/**/*.test.{cjs,js}",
    "!lib-commonjs/**/test/**",
    "!lib-commonjs/**/__tests__/**",
    "!lib-commonjs/**/__fixtures__/**",
    "!lib-commonjs/**/__mocks__/**"
  ]
}
