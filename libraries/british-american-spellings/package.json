{
  "name": "@americanize/british-american-spellings",
  "version": "0.1.0",
  "description": "A reviewable table of British -> American word spellings, with case-preserving lookup helpers.",
  "repository": {
    "type": "git",
    "url": "https://github.com/iclanton/americanize.git",
    "directory": "libraries/british-american-spellings"
  },
  "homepage": "https://github.com/iclanton/americanize/tree/main/libraries/british-american-spellings#readme",
  "bugs": "https://github.com/iclanton/americanize/issues",
  "license": "MIT",
  "author": "Ian Clanton-Thuon",
  "main": "./lib-commonjs/index.js",
  "module": "./lib-esm/index.js",
  "types": "./dist/british-american-spellings.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/british-american-spellings.d.ts",
      "import": "./lib-esm/index.js",
      "require": "./lib-commonjs/index.js"
    },
    "./lib/*": {
      "types": "./lib-dts/*.d.ts",
      "import": "./lib-esm/*.js",
      "require": "./lib-commonjs/*.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "lib-commonjs",
    "lib-esm",
    "lib-dts",
    "NOTICE.md"
  ],
  "scripts": {
    "build": "heft build --clean",
    "test": "heft test --clean",
    "_phase:build": "heft run --only build -- --clean",
    "_phase:test": "heft run --only test -- --clean"
  },
  "dependencies": {
    "tslib": "~2.8.1"
  },
  "devDependencies": {
    "@americanize/eslint-config": "workspace:*",
    "@americanize/local-build-rig": "workspace:*",
    "@rushstack/heft": "1.2.25",
    "eslint": "~9.37.0"
  }
}
