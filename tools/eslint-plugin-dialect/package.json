{
  "name": "eslint-plugin-dialect",
  "version": "0.2.0",
  "description": "An ESLint rule that enforces a single English dialect (American or British) in identifiers, comments and strings.",
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "spelling",
    "dialect",
    "american",
    "british"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/iclanton/americanize.git",
    "directory": "tools/eslint-plugin-dialect"
  },
  "homepage": "https://github.com/iclanton/americanize/tree/main/tools/eslint-plugin-dialect#readme",
  "bugs": "https://github.com/iclanton/americanize/issues",
  "license": "MIT",
  "author": "Ian Clanton-Thuon",
  "main": "./lib-commonjs/index.js",
  "types": "./lib-dts/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib-dts/index.d.ts",
      "require": "./lib-commonjs/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib-commonjs",
    "lib-dts"
  ],
  "peerDependencies": {
    "eslint": ">=9.0.0"
  },
  "scripts": {
    "build": "heft build --clean",
    "test": "heft test --clean",
    "_phase:build": "heft run --only build -- --clean",
    "_phase:test": "heft run --only test -- --clean"
  },
  "dependencies": {
    "@americanize/british-american-spellings": "workspace:^",
    "tslib": "~2.8.1"
  },
  "devDependencies": {
    "@americanize/eslint-config": "workspace:*",
    "@americanize/local-build-rig": "workspace:*",
    "@rushstack/heft": "1.2.25",
    "@types/estree": "~1.0.6",
    "eslint": "~9.37.0"
  }
}
